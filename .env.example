# ─────────────────────────────────────────────────────────────
# Nền tảng khảo thí online ứng dụng AI — Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env vào git
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=datn
POSTGRES_PASSWORD=change_me_postgres

# Redis
REDIS_PASSWORD=change_me_redis

# RabbitMQ
RABBITMQ_USER=datn
RABBITMQ_PASSWORD=change_me_rabbitmq

# JWT — tối thiểu 64 ký tự, base64-encoded hoặc random string mạnh
# Tạo bằng: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_AT_LEAST_64_CHARS_LONG_base64encodedValue

# Service-to-service contracts (use separate random secrets; never reuse JWT_SECRET)
QB_INTERNAL_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_FOR_QUESTION_BANK
EXAM_INTERNAL_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_FOR_EXAM_SESSION_AND_GRADING
ANALYTICS_EXAM_PERMISSION_TOKEN=REPLACE_WITH_A_SEPARATE_PERMISSION_ONLY_RANDOM_SECRET
# Narrow identity lookup and Organization authorization; blank values fail closed.
EXAM_IDENTITY_TOKEN=
ORGANIZATION_IDENTITY_TOKEN=
QUESTION_BANK_IDENTITY_TOKEN=
ORG_AUTHZ_QB_TOKEN=
# Notification-only credentials: empty disables the corresponding internal provider API.
NOTIFICATION_CONTACT_TOKEN=
EXAM_NOTIFICATION_TOKEN=
# Public frontend origin used by notification links; match the actual UI runtime.
APP_BASE_URL=http://localhost:3000

# Scheduling email sender. Fill locally; never commit an address/app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true

# Browser Push VAPID P-256 pair (base64url). Public key may be exposed via API;
# private key stays only on Notification. Subject is a configured mailto:/https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional in development. Required for a fresh production install with no existing Admin.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# Token expiry (milliseconds)
JWT_ACCESS_EXPIRY_MS=900000       # 15 phút
JWT_REFRESH_EXPIRY_MS=604800000   # 7 ngày

# Google Sign-In: OAuth 2.0 "Web application" client id (public). Blank = the Google button is hidden.
# Authorized JavaScript origins must include the site URL, e.g. http://localhost:3000.
GOOGLE_CLIENT_ID=

# ── AI (đều tuỳ chọn; không có thì hệ thống dùng bộ sinh câu hỏi/nhận xét theo luật, chấm tự luận thủ công) ──
# Các nguồn được thử lần lượt; hết lượt miễn phí ở nguồn này thì tự chuyển sang nguồn sau.
# 1) Gemini — miễn phí ở Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 2) Bất kỳ API tương thích OpenAI. Gợi ý miễn phí:
#    Groq:        AI_OPENAI_URL=https://api.groq.com/openai/v1   AI_OPENAI_MODEL=llama-3.3-70b-versatile   (key: console.groq.com)
#    OpenRouter:  AI_OPENAI_URL=https://openrouter.ai/api/v1     AI_OPENAI_MODEL=<tên mô hình có đuôi :free>
#    Mistral:     AI_OPENAI_URL=https://api.mistral.ai/v1        AI_OPENAI_MODEL=mistral-small-latest
#    Máy cá nhân: LM Studio http://host.docker.internal:1234/v1, hoặc Ollama http://ollama:11434/v1 (key để trống)
AI_OPENAI_URL=
AI_OPENAI_KEY=
AI_OPENAI_MODEL=
# 3) Mô hình tự chạy bằng Ollama: docker compose --profile ai up -d ollama, rồi OLLAMA_URL=http://ollama:11434
#    qwen2.5:7b-instruct viết tiếng Việt tốt, cần khoảng 8 GB RAM.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct
# Thứ tự nguồn khi sinh câu hỏi; "local" là bộ sinh theo luật, không cần mạng.
QB_AI_PROVIDERS=gemini,openai,ollama,local
# Sau khi sinh, AI giải lại câu trắc nghiệm (không xem đáp án) để phát hiện đáp án sai. Tốn thêm 1 lượt gọi.
QB_AI_VERIFY_KEYS=true
# Fetch Wikipedia knowledge for topics without teacher material.
QB_AI_WEB_KNOWLEDGE=true

# Camera proctoring: snapshots and video are deleted this many days after the exam deadline (0 = keep forever).
CAMERA_RETENTION_DAYS=30

# Dev: when SMTP is not set, reset links are written to the auth-service log. Set false in production.
AUTH_RESET_LOG_LINKS=true

# Cổng web khi chạy bằng docker compose (container frontend: nginx phục vụ giao diện + chuyển /api tới gateway).
# Khi chạy bằng Docker thì đặt APP_BASE_URL=http://localhost:${WEB_PORT}, Google origin cũng vậy.
WEB_PORT=80

# Sinh câu hỏi, gợi ý chấm tự luận và nhận xét thống kê dùng chung các khoá AI ở trên; không có thì dùng luật.
# File đính kèm (ảnh/âm thanh câu hỏi, bài nói, ảnh camera) nằm trong volume Docker:
#   question_media, answer_audio, camera_data — sao lưu bằng ./scripts/backup.sh

# Giới hạn tần suất ở gateway (theo IP). Mặc định đủ cho cả lớp dùng chung IP trường.
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_SIGN_IN_PER_MINUTE=300
# Origin khác được gọi API trực tiếp (dev Vite :3000). Giao diện qua nginx dùng chung origin nên không cần thêm.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
