# ─────────────────────────────────────────────────────────────
# Nền tảng khảo thí online ứng dụng AI — Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env vào git
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=datn
POSTGRES_PASSWORD=change_me_postgres

# Redis
REDIS_PASSWORD=change_me_redis

# RabbitMQ
RABBITMQ_USER=datn
RABBITMQ_PASSWORD=change_me_rabbitmq

# JWT — tối thiểu 64 ký tự, base64-encoded hoặc random string mạnh
# Tạo bằng: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_AT_LEAST_64_CHARS_LONG_base64encodedValue

# Service-to-service contracts (use separate random secrets; never reuse JWT_SECRET)
QB_INTERNAL_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_FOR_QUESTION_BANK
EXAM_INTERNAL_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_FOR_EXAM_SESSION_AND_GRADING
ANALYTICS_EXAM_PERMISSION_TOKEN=REPLACE_WITH_A_SEPARATE_PERMISSION_ONLY_RANDOM_SECRET
# Narrow identity lookup and Organization authorization; blank values fail closed.
EXAM_IDENTITY_TOKEN=
ORGANIZATION_IDENTITY_TOKEN=
ORG_AUTHZ_QB_TOKEN=
# Notification-only credentials: empty disables the corresponding internal provider API.
NOTIFICATION_CONTACT_TOKEN=
EXAM_NOTIFICATION_TOKEN=
# Public frontend origin used by notification links; match the actual UI runtime.
APP_BASE_URL=http://localhost:3000

# Scheduling email sender. Fill locally; never commit an address/app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true

# Browser Push VAPID P-256 pair (base64url). Public key may be exposed via API;
# private key stays only on Notification. Subject is a configured mailto:/https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional in development. Required for a fresh production install with no existing Admin.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# Token expiry (milliseconds)
JWT_ACCESS_EXPIRY_MS=900000       # 15 phút
JWT_REFRESH_EXPIRY_MS=604800000   # 7 ngày

# OpenAI / Claude API (Giai đoạn 4 — ai-service)
OPENAI_API_KEY=
CLAUDE_API_KEY=
